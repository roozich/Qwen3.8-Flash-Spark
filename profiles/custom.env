# desc: every serve.sh knob at its stock default on one line each: the starting point for tuning and benchmarks
#
# Copy this file (or edit it in place) to build your own profile: every variable
# below is exactly what scripts/serve.sh applies with no profile at all, so
#   ./flash serve custom
# behaves like the stock defaults. Change one line, serve, compare. `KEY=VALUE`
# arguments still win over everything here:
#   ./flash serve custom SEQS=16 CTX=131072
# Full docs for each knob: scripts/serve.sh header / docs/CONFIGURATION.md.
# NOTE: values keep the whole rest of the line, so comments must go on their own
# line above, not after a value.
#
# Reminder: profiles/default.env is NOT this file - the recommended recipe there
# deliberately differs (MODE=hybrid, YARN=1, CTX=500000). This file is the
# untouched serve.sh baseline.

# --- identity / image -----------------------------------------------------
# Container name, API port (binds 0.0.0.0 with no auth), model name the API serves.
NAME=qwen38-flash
PORT=18300
SERVED_MODEL_NAME=qwen3.8-flash-next

# Image tag must be built from this repo's Dockerfile (label qwen38.base=v0.32).
IMAGE=qwen38-flash-dgx:v0.32

# Checkpoint (RadixArk/Qwen3.8-Flash-Next-NVFP4 is still supported).
MODEL=nvidia/Qwen3.8-Flash-Next-NVFP4
# MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4

# Weights cache: leave this line out to use ~/.cache/huggingface (write
# HF_CACHE=... in your shell if you need another one; $HOME is not expanded here).

# --- checkpoint layout -----------------------------------------------------
# Which on-disk copy of the weights to load. hybrid / hybrid-mtp need one-time
# prepare scripts (prepare-hybrid.sh, then prepare-mtp-graft.sh) before they serve.
#   nvfp4       = the checkpoint as downloaded, no prep needed (the default).
#   hybrid      = side layers re-quantized to fp8: +20% decode, +15-20% KV room,
#                 same quality. Works with either checkpoint below.
#   hybrid-mtp  = hybrid + NVFP4 MTP draft experts grafted in: ~3.4 GB less GPU
#                 memory. RadixArk checkpoint only (the NVIDIA one already has an
#                 fp8 drafter, so use hybrid there), e.g.:
#                   MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4
#                   MODE=hybrid-mtp
MODE=nvfp4
# MODE=hybrid
# MODE=hybrid-mtp

# --- context ---------------------------------------------------------------
# Native max is 262144. For more, set YARN=1 and raise CTX (validated to ~500000).
CTX=262144
YARN=0

# KV cache dtype: auto (=bf16) is the safe choice; fp8_e4m3 gives ~1.9x KV at a
# speed+quality cost (see docs/BENCHMARKS.md).
KV_DTYPE=auto
# KV_DTYPE=fp8_e4m3

# Optionally fix the KV budget in bytes instead of using GPU_MEM (serve.sh prints
# the exact value vLLM would accept at boot). Empty = vLLM decides.
KV_CACHE_MEM=

# --- batching / memory -------------------------------------------------------
# Max concurrent sequences. Do NOT leave this at 1-2 when measuring aggregate
# throughput: requests queue silently and tok/s flatlines.
SEQS=8

# Fraction of the 128 GB unified pool for weights+KV. 0.85 drifted into swap after
# a day, 0.875 OOM-killed on a 300k prefill (README).
GPU_MEM=0.80

# GDN recurrent-state pool dtype: empty = vLLM default (float32); bfloat16 halves
# the pool to free room for SEQS.
MAMBA_SSM_DTYPE=

# Pin to cores. Default = the GB10's 10 Cortex-X5 performance cores.
# CPUSET= (empty) = all 20 cores.
CPUSET=5-9,15-19

# --- correctness / determinism -----------------------------------------------
# Prefix caching (correct with this image's block-size fix; big TTFT win on
# repeated prefixes). 0 to measure cold prefill every time.
PREFIX_CACHE=1

# Deterministic QSA top-k kernel (the default, no prefill cost). EXACT_TOPK=1 is
# the slower exact fallback (-20-40% long prefill) and wins over DET_TOPK.
DET_TOPK=1
EXACT_TOPK=0

# Accept reasoning_effort high/max/minimal (map to xhigh/low) instead of 400ing.
EFFORT_ALIAS=1

# --- speculative decoding ----------------------------------------------------
# MTP draft tokens from the model's own head. 0 = off.
MTP=2

# Prune the MTP drafter to the 65,536 most frequent tokens (+20% decode, same
# tournament score). MTP-head only; ignored when DRAFT_MODEL is set.
DRAFT_VOCAB=1

# DFlash2 draft model (needs scripts/download-draft.sh + the patched image);
# replaces the MTP head entirely (MTP is then ignored). Empty = off.
# To enable, set it on its own line (never trail a comment after a value):
# DRAFT_MODEL=incoai/Qwen3.8-Flash-Next-DFlash2
DRAFT_MODEL=
DRAFT_TOKENS=4

# --- PLE mmap table -----------------------------------------------------------
# madvise on the mmapped table: random (default, no readahead) or normal.
MADVISE=random

# Gathers of up to this many unique rows run inline on one thread; 0 (default) =
# every gather on the WORKERS pool (the faster measured path), 512 = old inline path.
FAST_ROWS=0
WORKERS=32

# 1 = stream the 48 GiB table once at boot to warm the page cache.
PREWARM=0

# --- misc ----------------------------------------------------------------------
# 1 = engine-side vllm:ple_mmap_* metrics reach /metrics.
PROM_MULTIPROC=0

# 1 = log every prompt+output for tools/vllm_watch.py (privacy + unbounded logs).
LOG_REQUESTS=0

# Where JIT/Triton/FlashInfer caches survive reboots: empty (default) = rebuilt
# every boot (~37 s); a bare name = docker volumes, an absolute path = bind dirs.
COMPILE_CACHE=

# Extra vLLM flags, passed verbatim.
EXTRA=
